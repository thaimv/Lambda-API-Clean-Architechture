# Copy to envs/.env.e2e before running E2E tests
# cp envs/.env.e2e.example envs/.env.e2e

# ── AWS region ─────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-2

# ── AWS credentials for CloudWatch Live Tail ───────────────────────────────────
# Needs: logs:StartLiveTail on the log group ARNs below.
# Leave blank to rely on ambient credentials (SSO / instance profile / env).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AppSync endpoint ───────────────────────────────────────────────────────────
GRAPHQL_ENDPOINT=https://xxxxxxxxxxxxxxxxxx.appsync-api.eu-west-2.amazonaws.com/graphql

# ── REST API Gateway base URLs ─────────────────────────────────────────────────
# public-api Lambda (IAM + x-api-key)
PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com/v1
PUBLIC_API_KEY=your-public-api-gateway-api-key
# auth-api Lambda (cookie + optional x-api-key)
AUTH_API_BASE_URL=https://yyyyyyyyyy.execute-api.eu-west-2.amazonaws.com/v1
AUTH_API_KEY=

# ── Cognito ────────────────────────────────────────────────────────────────────
# Tests call InitiateAuth (USER_PASSWORD_AUTH) at bootstrap to get a Cognito idToken,
# then exchange it for temporary AWS credentials (SigV4) used to sign AppSync requests.
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=eu-west-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

TEST_USER_USERNAME=test-user@example.com
TEST_USER_PASSWORD=

# ── Database (Prisma) ──────────────────────────────────────────────────────────
# Direct connection URL for E2E DB assertions (bypasses Secrets Manager).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# ── CloudWatch ─────────────────────────────────────────────────────────────────
# ARNs of Lambda CloudWatch log groups — used for Live Tail during test runs.
# Format: arn:aws:logs:<region>:<account>:log-group:/aws/lambda/<function-name>
APPSYNC_LAMBDA_LOG_GROUP_ARN=arn:aws:logs:eu-west-2:123456789012:log-group:/aws/lambda/project-dev-appsync-api
PUBLIC_API_LAMBDA_LOG_GROUP_ARN=arn:aws:logs:eu-west-2:123456789012:log-group:/aws/lambda/project-dev-public-api

# Seconds to wait after invocation before stopping Live Tail and asserting.
# Increase for cold-start Lambdas or VPC Lambdas with slow log delivery.
CLOUDWATCH_LOG_FLUSH_WAIT=20
