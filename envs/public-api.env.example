# public-api Lambda — environment variables
# Copy for local dev: cp envs/public-api.env.example envs/.env
# Or merge into envs/.env when running both Lambdas locally.

# Runtime
NODE_ENV=local
LOG_LEVEL=DEBUG
AWS_REGION=eu-west-1

# DynamoDB (required when DynamoDB module loads)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_USER_NOTIFICATION_TABLE=TestUserNotificationTable
DYNAMODB_USER_NOTIFICATION_TABLE_LSI1=test-notification-lsi1
DYNAMODB_USER_NOTIFICATION_TABLE_LSI2=test-notification-lsi2
