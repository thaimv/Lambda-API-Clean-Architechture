# appsync-api Lambda — environment variables
# Copy for local dev: cp envs/appsync-api.env.example envs/.env

# Runtime
NODE_ENV=local
LOG_LEVEL=DEBUG
AWS_REGION=eu-west-1

# --- Database: local / test (NODE_ENV=local or test) ---
# Prisma reads DATABASE_URL directly — Secrets Manager is NOT used.
DATABASE_URL=postgresql://user:root@localhost:5433/app?schema=public
DATABASE_URL_REPLICA=postgresql://user:root@localhost:5433/app?schema=public

# --- Database: dev / stg / prd (NODE_ENV=dev|stg|prd) ---
# Prisma builds connection string from Secrets Manager + RDS Proxy.
# DATABASE_URL is NOT required on Lambda; set these instead:
# NODE_ENV=dev
# RDS_PROXY_ENDPOINT=your-proxy.proxy-xxxxx.region.rds.amazonaws.com
# RDS_PROXY_ENDPOINT_REPLICA=your-proxy-replica.proxy-xxxxx.region.rds.amazonaws.com
# RDS_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:rds-credentials-xxxx
#
# Secret JSON (AWS RDS auto-generated) example:
# {
#   "username": "db_user",
#   "password": "********",
#   "engine": "postgres",
#   "host": "cluster.xxxxx.region.rds.amazonaws.com",
#   "port": 5432,
#   "dbname": "app",
#   "dbClusterIdentifier": "cluster-name"
# }
# Lambda IAM role needs: secretsmanager:GetSecretValue on RDS_SECRET_ARN

# Placeholders (required by AppConfig even in local)
RDS_PROXY_ENDPOINT=local-rds-proxy
RDS_PROXY_ENDPOINT_REPLICA=local-rds-proxy
RDS_SECRET_ARN=local-rds-secret

# DynamoDB (shared bootstrap — required at import)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_USER_NOTIFICATION_TABLE=TestUserNotificationTable
DYNAMODB_USER_NOTIFICATION_TABLE_LSI1=test-notification-lsi1
DYNAMODB_USER_NOTIFICATION_TABLE_LSI2=test-notification-lsi2
