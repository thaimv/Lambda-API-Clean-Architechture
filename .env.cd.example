# LambdaAPIs — GitHub Environment deploy config (template)
#
# Do not commit this file with real values. Copy this checklist to GitHub:
#   Settings → Environments → api-develop | api-staging
#
# Workflow: .github/workflows/cd.yml
#   push develop → api-develop
#   push staging → api-staging
#
# Infra (Lambda, API Gateway, AppSync) must be deployed first from the cdk/ repo.
# Get function names / layer names / API ID from CDK stack outputs.
#
# ── Secret → GitHub Environment **Secrets** (not Variables) ──────────────────
AWS_ROLE_TO_ASSUME=arn:aws:iam::194130476852:role/REPLACE_ME-github-oidc-lambdaapis
#
# ── Vars → GitHub Environment **Variables** — required ─────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=194130476852
LAMBDA_ALIAS_NAME=live
#
# Lambda function names (CDK output *FnName)
LAMBDA_FUNCTION_PUBLIC_API_NAME=thaimv-dev-public-api-function
LAMBDA_FUNCTION_AUTH_API_NAME=thaimv-dev-auth-api-function
LAMBDA_FUNCTION_APPSYNC_NAME=thaimv-dev-appsync-api-function
#
# AppSync (CDK output AppsyncApiId)
APPSYNC_API_ID=xxxxxxxxxxxxxxxxxxxx
#
# Prisma layer (CDK output PrismaLayerName)
PRISMA_LAYER_NAME=thaimv-dev-prisma-layer
#
# ── Vars — optional ───────────────────────────────────────────────────────
# Retains N most recent published versions for Lambda functions and Prisma layer.
KEEP_LAMBDA_VERSIONS=3
#
# ── Lambdas deployed by cd.yml ─────────────────────────────────────────────
#   public-api.zip   → LAMBDA_FUNCTION_PUBLIC_API_NAME (+ prisma layer)
#   auth-api.zip     → LAMBDA_FUNCTION_AUTH_API_NAME
#   appsync-api.zip  → LAMBDA_FUNCTION_APPSYNC_NAME (+ prisma layer + schema)
#
# ── Deploy order ───────────────────────────────────────────────────────────
# 1. cdk deploy
# 2. set vars on api-develop
# 3. push develop → build + prisma layer + deploy 3 lambdas + AppSync schema
